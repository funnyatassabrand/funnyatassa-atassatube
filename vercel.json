{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://funnyatassa.com https://www.funnyatassa.com https://funnyatassa.vercel.app"
        }
      ]
    }
  ]
}